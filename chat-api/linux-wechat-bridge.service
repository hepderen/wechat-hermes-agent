[Unit]
Description=Structured WeChat AI Group Bridge
After=network-online.target wechat-chat-api.service
Wants=network-online.target
Requires=wechat-chat-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/linux-wechat-bot
Environment=DISPLAY=:99
Environment=LANG=zh_CN.UTF-8
Environment=LC_ALL=zh_CN.UTF-8
EnvironmentFile=/etc/wechat-hermes/bridge.env
ExecStart=/usr/bin/python3 /home/ubuntu/linux-wechat-bot/db_bridge.py
Restart=always
RestartSec=5
Nice=10
MemoryMax=512M
CPUQuota=50%
TasksMax=128

[Install]
WantedBy=multi-user.target
