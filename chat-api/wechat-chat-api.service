[Unit]
Description=Local structured WeChat group API
After=network.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/wechat-chat-api
Environment=DISPLAY=:99
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
EnvironmentFile=/etc/wechat-hermes/chat-api.env
ExecStart=/home/ubuntu/wechat-chat-api/.venv/bin/python /home/ubuntu/wechat-chat-api/chat_api.py --config /home/ubuntu/wechat-chat-api/config.json
Restart=always
RestartSec=2
RestartForceExitStatus=SIGSEGV
TimeoutStartSec=30
TimeoutStopSec=10
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
LimitCORE=0
MemoryMax=1G
CPUQuota=100%
TasksMax=256
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.cache/wechat-chat-api
ReadWritePaths=/var/lib/wechat-hermes
InaccessiblePaths=/opt/wechat-ai-bot/data
InaccessiblePaths=-/var/lib/wechat-hermes/adapter-data -/var/lib/wechat-hermes/adapter.db -/var/lib/wechat-hermes/adapter.db-wal -/var/lib/wechat-hermes/adapter.db-shm
InaccessiblePaths=-/var/lib/wechat-hermes/artifacts -/var/lib/wechat-hermes/browser-downloads -/var/lib/wechat-hermes/candidates -/var/lib/wechat-hermes/chrome-for-testing
InaccessiblePaths=-/var/lib/wechat-hermes/home -/var/lib/wechat-hermes/skill-trust -/var/lib/wechat-hermes/workspace
InaccessiblePaths=-/etc/wechat-hermes/adapter.env -/etc/wechat-hermes/hermes.env -/etc/wechat-hermes/bridge.env -/home/ubuntu/.ssh -/root/.ssh -/run/docker.sock -/var/run/docker.sock
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=169.254.0.0/16
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
